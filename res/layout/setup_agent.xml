<com.google.android.setupdesign.GlifLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_wizard_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/SudContentFrame"
        android:layout_marginTop="@dimen/base_margin_top">

        <FrameLayout
            android:id="@+id/page"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/content_margin_left"
                    android:paddingRight="@dimen/content_margin_right">

                    <!-- Agent name -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/agent_name_label"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/agent_name_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/agent_default_name"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:imeOptions="actionNext" />

                    <!-- Creature / nature -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/agent_creature_label"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/agent_creature_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/agent_creature_hint"
                        android:inputType="textShortMessage"
                        android:maxLines="1"
                        android:imeOptions="actionNext" />

                    <!-- Personality -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/agent_personality_label"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp" />

                    <RadioGroup
                        android:id="@+id/personality_radio_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <RadioButton
                            android:id="@+id/radio_casual"
                            android:text="@string/personality_casual"
                            android:checked="true"
                            style="@style/SudRadioButton" />

                        <RadioButton
                            android:id="@+id/radio_professional"
                            android:text="@string/personality_professional"
                            style="@style/SudRadioButton" />

                        <RadioButton
                            android:id="@+id/radio_warm"
                            android:text="@string/personality_warm"
                            style="@style/SudRadioButton" />

                        <RadioButton
                            android:id="@+id/radio_playful"
                            android:text="@string/personality_playful"
                            style="@style/SudRadioButton" />

                    </RadioGroup>

                    <!-- Signature emoji -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/agent_emoji_label"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp" />

                    <GridLayout
                        android:id="@+id/emoji_grid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="8"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/agent_emoji_custom_label"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="?android:attr/textColorSecondary"
                        android:layout_marginTop="4dp" />

                    <EditText
                        android:id="@+id/agent_emoji_custom_input"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:inputType="text"
                        android:maxLength="2"
                        android:maxLines="1"
                        android:textSize="28sp"
                        android:layout_marginBottom="8dp"
                        android:imeOptions="actionNext" />

                    <!-- User name -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/user_name_label"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/user_name_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/user_name_hint"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:imeOptions="actionNext" />

                    <!-- What matters to you -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/user_interests_label"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/user_interests_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/user_interests_hint"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:maxLines="4"
                        android:gravity="top|start"
                        android:imeOptions="actionNext" />

                    <!-- Response style -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/response_style_label"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp" />

                    <RadioGroup
                        android:id="@+id/response_style_radio_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <RadioButton
                            android:id="@+id/radio_style_brief"
                            android:text="@string/style_brief"
                            style="@style/SudRadioButton" />

                        <RadioButton
                            android:id="@+id/radio_style_detailed"
                            android:text="@string/style_detailed"
                            style="@style/SudRadioButton" />

                        <RadioButton
                            android:id="@+id/radio_style_match"
                            android:text="@string/style_match"
                            android:checked="true"
                            style="@style/SudRadioButton" />

                    </RadioGroup>

                    <!-- Managed gateway account -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/agent_gateway_login_label"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/agent_gateway_login_hint"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="?android:attr/textColorSecondary"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/gateway_auth_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/agent_gateway_logged_out"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="?android:attr/textColorSecondary"
                        android:layout_marginBottom="8dp" />

                    <!-- Email OTP row -->
                    <LinearLayout
                        android:id="@+id/gateway_email_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <EditText
                            android:id="@+id/gateway_email_input"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:hint="@string/agent_gateway_email_hint"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:imeOptions="actionNext" />

                        <Button
                            android:id="@+id/gateway_send_code_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/agent_gateway_send_code" />
                    </LinearLayout>

                    <!-- OTP verify row (hidden until code sent) -->
                    <LinearLayout
                        android:id="@+id/gateway_otp_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:layout_marginBottom="8dp">

                        <EditText
                            android:id="@+id/gateway_otp_input"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:hint="@string/agent_gateway_otp_hint"
                            android:inputType="number"
                            android:maxLength="6"
                            android:maxLines="1"
                            android:imeOptions="actionDone" />

                        <Button
                            android:id="@+id/gateway_verify_code_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/agent_gateway_verify_code" />
                    </LinearLayout>

                    <!-- Google OAuth button -->
                    <Button
                        android:id="@+id/gateway_google_login_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/agent_gateway_google_login"
                        android:layout_marginBottom="16dp" />

                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <org.lineageos.setupwizard.NavigationLayout
            android:id="@+id/navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</com.google.android.setupdesign.GlifLayout>
